# Firebase Configuration
# Replace these with your actual Firebase project values
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------------------
# Server-side secrets for the AI agent (/api/agent).
# These are used ONLY by the Vercel serverless functions, never exposed to the
# browser (no VITE_ prefix). Set them in the Vercel dashboard for production.
# ---------------------------------------------------------------------------

# Which LLM provider the agent uses: "gemini" (free), "openai" (paid), or "anthropic" (paid).
# Defaults to "anthropic" if unset. Switching providers is just this one value.
LLM_PROVIDER=gemini

# --- Google Gemini (free tier) --- get a key at https://aistudio.google.com (no billing needed)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the default Gemini model
GEMINI_MODEL=gemini-2.0-flash

# --- OpenAI (GPT) --- from https://platform.openai.com (requires paid billing)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the default OpenAI model
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic (Claude) --- from https://console.anthropic.com  (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: override the default Claude model
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Firebase service account (Admin SDK) - paste the FULL JSON from
# Firebase Console > Project settings > Service accounts > Generate new private key.
# Paste as a single-line JSON string (escaped) in Vercel env settings.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
